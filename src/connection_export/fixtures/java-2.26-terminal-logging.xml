<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<connections>
    <connection>
        <name>Java logging fixture</name>
        <host>logging.example.test</host>
        <username>operator</username>
        <protocol>SSH_TCP</protocol>
        <logConfig>
            <includeUsername>true</includeUsername>
            <directoryMode>RELATIVE</directoryMode>
